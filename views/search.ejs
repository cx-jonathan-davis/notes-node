<%- include('partials/header', { title: 'Search', query: query }) %>

  <h1>Search</h1>
  <% if (query) { %>
    <p class="summary"><%= results.length %> result(s) for &ldquo;<%= query %>&rdquo;</p>
    <ul class="notes">
      <% if (results.length) { %>
        <% results.forEach(function (note) { %>
          <li>
            <a href="/notes/<%= note.id %>"><%= note.title %></a>
            <p><%= note.body %></p>
          </li>
        <% }); %>
      <% } else { %>
        <li class="empty">Nothing matched.</li>
      <% } %>
    </ul>
  <% } else { %>
    <p class="empty">Type something in the search box above.</p>
  <% } %>

<%- include('partials/footer') %>
